# Conexão do APP: papel restrito "barber_app" (sujeito ao RLS). No Neon, use a URL "pooled".
DATABASE_URL=postgresql://barber_app:SENHA_FORTE@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Usadas SOMENTE pelos scripts de migração/seed, na sua máquina. Nunca coloque na Vercel.
DATABASE_URL_OWNER=postgresql://neondb_owner:...@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
APP_DB_PASSWORD=SENHA_FORTE

# Endereço público do sistema (usado nos links de convite de encaixe)
APP_URL=https://sua-barbearia.vercel.app

# Provedor de mensagens: "manual" (copiar / abrir WhatsApp). Futuro: whatsapp-cloud
MESSAGING_PROVIDER=manual
